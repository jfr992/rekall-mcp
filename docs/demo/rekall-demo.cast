[0.302, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"total_memories\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m26\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"knowledge_graph\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m{\r\n    \u001b[0m\u001b[1;34m\"nodes\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m26\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"edges\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m17\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"relations\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"led_to\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m2\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"related_to\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m12\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"depends_on\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"supersedes\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"contradicts\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n"]
