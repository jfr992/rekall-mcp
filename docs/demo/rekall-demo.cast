[0.287, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"cues\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[0;32m\"destructive\"\u001b[0m\u001b[1;39m,\r\n    \u001b[0;32m\"iac\"\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"memories\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"content\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"Never run terraform destroy on the edge-prod workspace — the NATS KV store is not backed up\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"tier\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"semantic\"\u001b[0m\u001b[1;39m\r\n"]
[0.000, "o", "    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"content\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"Terraform destroy on edge-prod nearly ran during the June cleanup — added a workspace guard script\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"tier\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"episodic\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n"]
[0.000, "o", "    \u001b[1;39m{\r\n"]
[0.001, "o", "      \u001b[0m\u001b[1;34m\"content\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"Terraform state for the edge cluster lives in the shared S3 bucket with DynamoDB locking\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"tier\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"semantic\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
