# Rekall MCP - Environment Variables
# Copy to .env and customize

# =============================================================================
# EMBEDDING PROVIDERS
# =============================================================================
# Choose one: sentence-transformers (default), ollama, gemini
EMBEDDING_PROVIDER=sentence-transformers
# Override the embedding model name for the chosen provider
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Ollama Configuration (if using ollama provider)
OLLAMA_URL=http://localhost:11434

# Gemini Configuration (if using gemini provider)
GEMINI_API_KEY=your-gemini-api-key-here

# =============================================================================
# QDRANT VECTOR DATABASE
# =============================================================================
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-cloud-key-here  # Only for Qdrant Cloud

# =============================================================================
# MEMORY STORAGE
# =============================================================================
MEMORY_STORAGE_PATH=~/.claude/memory
QDRANT_DATA_PATH=~/.claude/qdrant

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# MCP Transport (stdio or streamable-http)
# Use streamable-http for Docker/HTTP mode (dashboard, REST API)
# Use stdio for direct Claude Code integration without Docker
MCP_TRANSPORT=streamable-http

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# HTTP server (when MCP_TRANSPORT=streamable-http)
HOST=0.0.0.0
PORT=8000

# Optional bearer-token auth. Unset = no auth (default). When set, every HTTP
# request except /health requires `Authorization: Bearer <token>`. Use this when
# binding 0.0.0.0 on an untrusted network. Clients must send the header:
#   claude mcp add --transport http rekall http://localhost:8000 \
#     --header "Authorization: Bearer <token>"
#   cockpit: set NEXT_PUBLIC_REKALL_API_TOKEN=<token> in ui/.env.local
# REKALL_API_TOKEN=change-me

# =============================================================================
# ADVANCED (optional — defaults are fine)
# =============================================================================
# Comma-separated tool providers to force-enable/disable (default: memory on)
# TOOLS_ENABLED=memory
# TOOLS_DISABLED=
# Path to a tools.yaml config file (see tools.yaml.example)
# MCP_CONFIG=tools.yaml
# Path to a config.yaml (see config.yaml.example)
# CONFIG_PATH=config.yaml
# Where OKF publish bundles are written (default: ~/.claude/publish)
# REKALL_PUBLISH_DIR=
# Where trust.yaml lives (default: ~/.claude/memory) — NOT the memory storage path
# REKALL_MEMORY_DIR=
