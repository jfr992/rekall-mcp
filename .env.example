# Memento MCP - Environment Variables
# Copy to .env and customize

# =============================================================================
# EMBEDDING PROVIDERS
# =============================================================================
# Choose one: sentence-transformers (default), ollama, gemini
EMBEDDING_PROVIDER=sentence-transformers

# Ollama Configuration (if using ollama provider)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# Gemini Configuration (if using gemini provider)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=models/embedding-001

# =============================================================================
# QDRANT VECTOR DATABASE
# =============================================================================
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-cloud-key-here  # Only for Qdrant Cloud

# =============================================================================
# MEMORY STORAGE
# =============================================================================
MEMORY_STORAGE_PATH=~/.claude/memory
QDRANT_DATA_PATH=~/.claude/qdrant

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# MCP Transport (stdio or streamable-http)
MCP_TRANSPORT=stdio

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# HTTP server (if MCP_TRANSPORT=streamable-http)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
